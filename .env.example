# ===== LLM 后端选择 =====
# openai = 走 OpenAI 协议(任意 base_url:OpenAI/DeepSeek/Qwen/Ollama/...)
# anthropic = 走 native anthropic SDK(保留 prompt caching / extended thinking)
LLM_PROVIDER=openai

# --- OpenAI 协议(LLM_PROVIDER=openai 时生效)---
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-...

# DeepSeek 示例
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-v4-pro
# LLM_API_KEY=sk-...

# DeepSeek Reasoner (推理模型)
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-reasoner
# LLM_API_KEY=sk-...

# OpenAI GPT-5 (支持 reasoning_effort)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5
# LLM_API_KEY=sk-...

# Ollama 本地示例
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=ollama

# --- Anthropic native(LLM_PROVIDER=anthropic 时生效)---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- 上下文窗口覆盖(可选)---
# 自研 tokenizer 内置了常见模型的 context limit 表,未知模型自动回退 32 k。
# 若你使用本地/Ollama 小众模型,可在此显式覆盖,单位:token。
# LLM_CONTEXT_LIMIT=32768

# --- 模型兼容性(可选)---
# 模型兼容性配置自动按 LLM_MODEL 名匹配 (deepseek-v4-pro / gpt-4o / claude / qwen 等)。
# 新增模型时在 apps/agent/src/prts_agent/llm/model_compat.py 注册即可,
# 无需改客户端代码。支持的标志:
# - thinking_format: 推理内容格式 ("" / "deepseek" / "openai" / "anthropic")
# - requires_reasoning_in_history: 多轮对话是否必须传回 reasoning_content
# - requires_nonempty_assistant_content: assistant content 不能为空
# - supports_stream_options: 支持 stream_options.include_usage

# ===== 进程端口 =====
# 8787/8788 在 Windows 默认排除段(8751-8850),用 4787/4788 避坑
DASHBOARD_PORT=5173
GATEWAY_PORT=4787
AGENT_PORT=4788

# ===== 路径 =====
# 默认 ~/.prts/workspace,首次启动从 ./workspace 模板初始化
PRTS_WORKSPACE_DIR=
# SQLite 文件
PRTS_DB_PATH=./db/prts.db

# ===== Telegram(P5 阶段)=====
TELEGRAM_BOT_TOKEN=
# polling(默认,开发用) | webhook(生产,需公网 HTTPS)
BOT_MODE=polling
